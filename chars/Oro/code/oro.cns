type = S

[State 180, 1]
type = ChangeState
trigger1 = random <= 166
value = 181

[State 180, 2]
type = ChangeState
trigger1 = random >= 836
value = 182

[State 180, 3]
type = ChangeState
trigger1 = (random >= 167) && (random <= 334)
value = 183

[State 180, 4]
type = ChangeState
trigger1 = (random >= 335) && (random <= 501)
value = 184

[State 180, 4]
type = ChangeState
trigger1 = (random >= 502) && (random <= 668)
value = 185

[State 180, 4]
type = ChangeState
trigger1 = (random >= 669) && (random <= 835)
value = 189


