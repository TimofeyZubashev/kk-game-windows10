trigger1 = anim != 196
trigger1 = anim != 0
trigger1 = P2Life > 0
loop = 1
value = 3,8
channel = 0
volume = 200;3
persistent = 0



[State 195, 1]
type = LifeAdd
trigger1 = AnimElem = 6
value = 10

[State 195, 5]
type = ChangeState
trigger1 = RoundState = 3
value = 0

[Statedef 196]
type = S
ctrl = 0
anim = 196
velset = 0,0
movetype = I
physics = S
sprpriority = 2

[State 195,snd_loop end]
type = stopsnd
trigger1 = anim = 196
trigger2 = P2Life <= 0
trigger3 = anim = 0
value = 3,8
channel = 0

[State 196, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

