;---------------------------------------------------------------------------
;Stand Parry
[Statedef 3000] 
type     = S
movetype = I
physics  = N
anim     = 3000
poweradd = 45
velset   = 0,0
ctrl     = 0
SprPriority = 2;4


[State 3000, 1]
type = PosSet
trigger1 = 1
y = 0

[State 3000, 2]
type = assertspecial
trigger1 = 1
flag = nowalk
flag2 = nostandguard
flag3 = nocrouchguard

[State 3000, 3]
type = pause
trigger1 = !time
time = 14;10
movetime = 5;10

[State 3000, 4]
type = nothitby
trigger1 = AnimElem = 1
time = 1
value = SCA


[State 3000, voice]
type = PlaySnd
trigger1 = animelem = 4
value = 3,1
channel = 0
volume = 200

[State 3000, Snd]
type = PlaySnd
trigger1 = time = 0
value = 2,0
volume = -30

[State 3000, 5]
type = envshake
trigger1 = !time
time = 8
frequency = 60
ampl = 3

[State 3000, 6]
type =palfx
trigger1 = !time
add = 30,30,100
sinadd = 30,30,100,8
time = 8

[State 3000, 6+]
type =palfx
trigger1 = !time
add = 30,30,100
sinadd = 30,30,100,8
time = 14;8



[State 3000, 7]
type = ctrlset
trigger1 = AnimTime >= 10;0
value = 1

[State 3000, 8]
type = ChangeState
Trigger1 = AnimTime = 0
value = 0
ctrl = 1

