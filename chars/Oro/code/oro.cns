[State 52, 3+ chicken land ctrl]
type = CtrlSet
trigger1 = AnimElem >= 7
Trigger1 = prevstateno = 1017 || 1510
trigger1 = prevstateno != 842
trigger1 = prevstateno != 49
trigger1 = prevstateno != 50
value = 1

[State 52, 3+ chicken land when movehit ctrl]
type = null;CtrlSet
trigger1 = AnimElem >= 1
Trigger1 = prevstateno = 1509
trigger1 = prevstateno != 842
trigger1 = prevstateno != 49
trigger1 = prevstateno != 50
value = 1


[State 52, 4 stand]
type = ChangeState
trigger1 = prevstateno = 1509
trigger1 = AnimElem = 2
value = 0 +  ((command = "holddown")*11)
ctrl = 1

