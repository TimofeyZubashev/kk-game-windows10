trigger1 = Time = 0
x = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, Turn_choke land]
type = Turn
trigger1 = prevstateno = 842
trigger1 = prevstateno != 49
trigger1 = prevstateno != 50
trigger1 = time = 0


[State 52, ChangeState]
type = ChangeState
triggerall = (command = "holddown")
trigger1 = (prevstateno = 50) && (prevstateno != 49) && (time >= 2)
trigger2 = (prevstateno = 600) && (time >= 2)
trigger3 = (prevstateno = 605) && (time >= 2)
trigger4 = (prevstateno = 610) && (time >= 2)
trigger5 = (prevstateno = 615) && (time >= 2)
trigger6 = (prevstateno = 620) && (time >= 2)
trigger7 = (prevstateno = 625) && (time >= 2)
trigger8 = (prevstateno = 630) && (time >= 2)
trigger9 = (prevstateno = 635) && (time >= 2)
trigger10 = (prevstateno = 640) && (time >= 2)
trigger11 = (prevstateno = 645) && (time >= 2)
trigger12 = (prevstateno = 650) && (time >= 2)
trigger13 = (prevstateno = 655) && (time >= 2)
trigger14 = (prevstateno = 660) && (time >= 2)
trigger15 = (prevstateno = 661) && (time >= 2)
trigger16 = (prevstateno = 49) && (prevstateno != 50) && (time >= 4)
value = 11
ctrl = 1



[State 52, CtrlSet_idle-after normal jump]
type = CtrlSet
triggerall = time >= 2;3
triggerall = prevstateno != 49
Triggerall = prevstateno != 1017
triggerall = prevstateno != 842
trigger1 = prevstateno = 50
trigger2 = prevstateno = 600
trigger3 = prevstateno = 605
trigger4 = prevstateno = 610
trigger5 = prevstateno = 615
trigger6 = prevstateno = 620
trigger7 = prevstateno = 625
trigger8 = prevstateno = 630
trigger9 = prevstateno = 635
trigger10 = prevstateno = 640
trigger11 = prevstateno = 645
trigger12 = prevstateno = 650
trigger13 = prevstateno = 655
trigger14 = prevstateno = 660
trigger15 = prevstateno = 661
;trigger1 = animelem >= 2
;trigger1 = command != "holddown"
;trigger1 = command != "holdup"
value = 1

[State 52, CtrlSet_idle-after super jump & air jump]
type = CtrlSet
;trigger1 = animelem >= 3
triggerall = time >= 4;5
triggerall = prevstateno != 600
triggerall = prevstateno != 605
triggerall = prevstateno != 610
triggerall = prevstateno != 615
triggerall = prevstateno != 620
triggerall = prevstateno != 625
triggerall = prevstateno != 630
triggerall = prevstateno != 635
triggerall = prevstateno != 640
triggerall = prevstateno != 645
triggerall = prevstateno != 650
triggerall = prevstateno != 655
triggerall = prevstateno != 50
Triggerall = prevstateno != 1017
triggerall = prevstateno != 842
triggerall = prevstateno != 660
triggerall = prevstateno != 661
trigger1 = prevstateno = 49
;trigger1 = command != "holddown"
;trigger1 = command != "holdup"
value = 1


