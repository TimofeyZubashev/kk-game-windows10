;Crouch Parry
[Statedef 3010] 
type     = C;S
movetype = I
physics  = N;C;N
anim     = 3010
poweradd = 45
velset   = 0,0
ctrl     = 0
SprPriority = 2;4

[State 3010, 1]
type = PosSet
trigger1 = 1
y = 0

[State 3010, 2]
type = assertspecial
trigger1 = 1
flag = nowalk
flag2 = nostandguard
flag3 = nocrouchguard

[State 3010, 3]
type = pause
trigger1 = !time
time = 14;10
movetime = 3;10

[State 3010, 4]
type = nothitby
;trigger1 = time < 10
trigger1 = AnimElem = 1
time = 1
value = SCA

[State 3010, voice]
type = PlaySnd
trigger1 = animelem = 2
value = 3,1
channel = 0
volume = 200

[State 3010, Snd]
type = PlaySnd
trigger1 = time = 0
value = 2,0
volume = -30

[State 3010, 5]
type = envshake
trigger1 = time = 0
time = 8
frequency = 60
ampl = 3

[State 3010, 6]
type =palfx
trigger1 = !time
add = 30,30,100
sinadd = 30,30,100,8
time = 8

[State 3010, 6+]
type =palfx
trigger1 = !time
add = 30,30,100
sinadd = 30,30,100,8
time = 12;8

[State 3010, 7]
type = ctrlset
trigger1 = AnimTime >= 7;0
value = 1

[State 3010, 8]
type = ChangeState
Trigger1 = AnimTime = 0
value = 11;0
ctrl = 1

