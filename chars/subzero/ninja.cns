[Data]
life = 1000
attack = 100
power = 9000
defence = 100
fall.defence_up = 50
liedown.time = 10
airjuggle = 999
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 255
IntPersistIndex = 40
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 20
ground.front = 20
air.back = 12
air.front = 12
height = 60 
attack.dist = 160
proj.attack.dist = 90 
proj.doscale = 0
head.pos = 0, -110
mid.pos = 0, -70 
shadowoffset = 1
draw.offset = 0,0

[Velocity]
walk.fwd  = 2.5
walk.back = -2
run.fwd  = 7, 0 
run.back = -5,-3
jump.neu = 0,-10.5
hello.im.neu = 2
jump.back = -2.9
jump.fwd = 3.3 
runjump.back = -2.9,-10.5
runjump.fwd = 3.3,-10.5
airjump.neu = 0,-8.1
airjump.back = -2.55 
airjump.fwd = 2.5

[Movement]
airjump.num = 0 
airjump.height = 35
yaccel = .55
stand.friction = .85
crouch.friction = .82

;---------------------------------------------------------------------------
;variables
;var(0) = jabsound                                                 fvar(0) = damage scaling
;var(1) = shao                                                     fvar(1) = juggle
;var(2) = freezelimit                                              fvar(2) = 
;var(3) = ow
;var(4) = fatal bitch


;var(41) = wincount
;var(58) = max wins
;---------------------------------------------------------------------------
; Introduction
[Statedef 191]
type = S
ctrl = 0
anim = 0
velset = 0,0

[State ] 
type = poweradd
trigger1 = !time
value = 9999

[State 191, 1]
type = ChangeAnim
trigger1 = !RoundState
value = 190

[State ]
type = varset
trigger1 = command = "code"
persistent = 0
var(58) = -2
[State ]
type = playsnd
trigger1 = command = "code"
persistent = 0
abspan = 1
value = 1,9

[State 191, 2]
type = AssertSpecial
trigger1 = 1
flag = Intro


[State 191, 3]
type = ChangeState
trigger1 = !AnimTime
value = 0
;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1
;---------------------------------------------------------------------------
; Win pose - FUCK YOU!
[Statedef 180]
type = S
ctrl = 0
;anim = 180
velset = 0,0

[State ]
type = changeanim 
trigger1 =  !time && anim != 6014
value = 180

[State ]
type = varadd
trigger1 =  !time
ignorehitpause = 1
var(41) = 1

[State sound]
type = PlaySnd
trigger1 = !time
abspan = 1
value = 4, 8
[State sound]
type = PlaySnd
trigger1 = time = 120 && winperfect
abspan = 1
value = 4, 9

[State sound]
type = null;PlaySnd
trigger1 = animelemtime(7) = 2
value = 4, 6

[State ]
type = assertspecial
triggerall = winperfect
trigger1 = time <= 240
ignorehitpause = 1
flag = roundnotover
[State ]
type = assertspecial
triggerall = numhelper(7021) 
trigger1 = helper(7021),var(0) = 1 && (time <= 350 && winperfect || time <= 240 && !winperfect)
ignorehitpause = 1
flag = roundnotover

[State ]
type = varset
triggerall = var(58) != -1 && var(58) != -2 && var(41) >=2
trigger1 = matchover && var(41) > var(58)
persistent = 0
var(58) = var(41) -1

[State ]
type = varset
triggerall = var(58) != -2  && !(var(41) >= 2)
trigger1 = matchover && var(41) = 1
persistent = 0
var(58) = -1
