[Statedef 7000]
type    = A
movetype= A
physics = N
poweradd= 0
anim = 7000
velset = 0,0
ctrl = 0
sprpriority = 3

[State sound]
type = PlaySnd
trigger1 = !time
freqmul = .7
value = 1, 2

[State sound]
type = velset
trigger1 = time = 8
x = 8
[State ]
type = ChangeState
value = 6099
triggerall = name != "Pneophen's real cool guy"
trigger1 = 1

[State ò_ó]
type = Explod
trigger1 = time >= 6 && !(time%3)
anim = 7003
id = 7003
Postype = p1
pos = 0,0
random = 40,20
sprpriority = 2
velocity = 0,2
ownpal = 1

[State ]
type = Hitdef
trigger1 = !movecontact
damage = ifelse(((parent,var(41) = parent,var(58)) || (parent,var(58) = -1)) && enemynear,life = 1,1,0),0
getpower = 0,0
givepower = 0,0
pausetime = 0,10
attr = A,SP
guardflag = M
animtype = heavy
air.animtype = back
priority = 5, hit
sparkno = S7001
guard.sparkno = S7001
sparkxy = 40, 0
hitsound = S1,3
guardsound = S0,7
ground.type = high
air.type = high
ground.slidetime = 0
ground.hittime = 15
ground.velocity = 0, 0 
air.velocity = 0, 0
guard.velocity = -7
air.cornerpush.veloff = 0
ground.cornerpush.veloff = 0
yaccel = .5
p1stateno = ifelse(!parent,var(2),7005,7001)
p2stateno = ifelse(!parent,var(2),7002,7006)
air.fall = 1
fall = ifelse(parent,stateno = 6000 && (parent,prevstateno = [8000,8003]) && enemynear,movetype = H,1,0)
fall.recover = 0
fall.xvelocity = 0
fall.yvelocity = 0
numhits = 0

[State don't playa hate]
type = playerpush
trigger1 = 1
value = 0

[State ]
type = assertspecial
trigger1 = 1
flag = noshadow

[State end]
type = changestate
trigger1 = moveguarded
value = 7001

[State end]
type = destroyself
trigger1 = time <= 7 && parent,movetype = H

[State end]
type = destroyself
trigger1 = frontedgedist <= -150
