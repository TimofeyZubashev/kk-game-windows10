;var(17) ダッシュ用
;var(29) 地上ダスト追撃用・・・重力変化、攻撃ヒット時相手の浮き
;var(27) 空中ダッシュ用・・・１以上使用不可
;var(59) サイクバースト用・・・１以上使用不可
;var(33) 一撃モード用
;var(24) 一撃モード用・・・徐々にライフ減、残像付加
;var(60) AI用
;var(38) 鳳効果用・・・１以上攻撃力上昇、文字ヘルパー表示
;var(39) 龍効果用・・・１以上防御力上昇、文字ヘルパー表示
;var(43) 麟効果用・・・１以上ガード不能、文字ヘルパー表示
;var(44) 亀効果用・・・１以上ジャンプ封じ（封印用ヘルパー出現）、文字ヘルパー表示
;var(47) 神効果用・・・１以上体力回復、移動速度UP、一定時間自分発光、文字ヘルパー表示
;var(31) 鶴効果用・・・１以上中上段のけぞり無効、文字ヘルパー表示
;var(32) のけぞり無効用 
;var(19) 2段ジャンプ用 
;var(34) ハイジャンプ振り向き
;var(46) 空中ダッシュ 
;var(37) 勝利時BGM停止 
;fvar(4) フォルトレスガード用
;fvar(2) 徐々にサイズ変更用

[Data]
life = 1000
attack = 84
defence = 124
fall.defence_up = 70
liedown.time = 60
airjuggle = 16
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 200
power = 2000
IntPersistIndex = 57

[Size]
xscale = 0.5
yscale = 0.5
ground.back = 25
ground.front = 25
air.back = 20
air.front = 20
z.width = 5
attack.width = 4,4
attack.dist = 180
proj.attack.dist = 90
draw.offset = 0,0

[Movement]
airjump.num = 1
airjump.height = 35
yaccel = .48
stand.friction = .82
crouch.friction = .82

[Velocity]
walk.fwd  = 1.6
walk.back = -1.6
run.fwd  = 3　　    		;前ダッシュの速度（x, y)
run.back  = 2,-5.8     	;前ダッシュの速度（x, y)
jump.neu = 0,-9.6     	;垂直ジャンプの速度(x, y)
jump.back = -2        	;後ろジャンプの速度(x, y)
jump.fwd = 2  
runjump.back = -3.8,0.6    ; 後方ジャンプ速度（ダッシュ中）
runjump.fwd = 3.8,-9.6    ; 前方ジャンプ速度（ダッシュ中）
airjump.neu = 0,-7.8      	;垂直２段ジャンプの速度 (省略可能)
airjump.back = -2.7      	;後ろ２段ジャンプの速度 (省略可能)
airjump.fwd = 2.7         	;前２段ジャンプの速度 (省略可能)


