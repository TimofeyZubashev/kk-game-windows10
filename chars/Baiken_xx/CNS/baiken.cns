trigger1 = Time = 0
y = 0

[State 0,1]
type = AfterImage
trigger1 = var(24) = 2
trigger1 = time = 0
time = 9999999
trans = add
timegap = 1
framegap = 1
length = 6
PalBright   =   0,  0,  0
PalContrast = 255,0,0
PalAdd      =   0,  0,  0
PalMul      =  .9, .9, .9

[State 0,1]
type = AfterImage
trigger1 = var(24) != 2
trigger1 = time = 0
time = 0
trans = add
timegap = 1
framegap = 1
length = 6
PalBright   =   0,  0,  0
PalContrast = 255,0,0
PalAdd      =   0,  0,  0
PalMul      =  .9, .9, .9

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
