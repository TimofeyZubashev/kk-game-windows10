;=============================================================================
[Info]
name 		= "Shutdown Industrial Steel Factory"
displayname 	= "Industrial Steel Factory" 
mugenversion 	= 1.0
author 		= "Alpyne D"


[Music]
bgmusic = stages/Alpz_Industrial_Steel/fokus_from_24s.mp3
;bgmusic 	= stages/Alpz_Industrial_Steel/Alpz_Industrial_Steel_2.mp3

bgmvolume = 75


[Camera]
startx 		= 0
starty 		= 0
boundleft 	= -144
boundright 	= 144
boundhigh 	= -110
boundlow 	= 0
tension 	= 50
verticalfollow 	= .95
floortension 	= 98
overdrawhigh 	= 120
overdrawlow 	= 120
cuthigh 	= 0
cutlow 		= 0

[PlayerInfo]
p1startx 	= -70
p1starty 	= 0
p1facing 	= 1
p2startx 	= 70
p2starty 	= 0
p2facing 	= -1
p3startx 	= -100
p3starty 	= 0
p3facing 	= 1
p4startx 	= 100
p4starty 	= 0
p4facing 	= -1
leftbound 	= -1000
rightbound 	= 1000

[Bound]
screenleft 	= 15
screenright 	= 15

[StageInfo]
zoffset 	= 220.0
autoturn 	= 1
resetBG 	= 0
localcoord 	= 320, 240
xscale 		= 1
yscale 		= 1
portraitscale = 1

[Scaling]
topz     	= 0
botz     	= 50
topscale 	= 1
botscale 	= 1.2

[Shadow]
color 		= 0,0,0
yscale 		= .1

[BGdef]
spr 		= Alpz_Industrial_Steel.sff
debugbg 	= 0


;======================================================================

[BG Factory Background]
type = normal
start = 0,0
spriteno = 1,2
delta = 0.2,1
mask = 1


[BG Main]
type  		= normal
spriteno 	= 1, 1
start 		= 0,-16
delta 		= 1,1
mask     	= 1


[BG STEAM]
type  	   	= anim
actionno 	= 1
start 		= 198,48
delta 	        = 1,1
mask            = 1
layerno         = 0


[BG Can]
type  		= normal
spriteno 	= 2, 1
start 		= 95,115
delta 		= 1.03,1
mask            = 1
layerno         = 0


[BG FG Side Can]
type  		= normal
spriteno 	= 2, 3
start 		= -278,145
delta 		= 1,1
mask            = 1
layerno         = 0


[BG FG Side Can Trans]
type  		= normal
spriteno 	= 2, 3
start 		= -278,145
delta 		= 1,1
mask            = 1
trans     	= add1
layerno         = 1


